.mypy_cache/
.ruff_cache/
dist/
*.egg-info/

# ── Node ──────────────────────────────────────────────────────────────────────
node_modules/
frontend/dist/

# ── Дані ────────────────────────────────────────────────────────────────────
# З провідним "/" — тільки директорії в корені проєкту. Без "/" ці ж назви
# збігаються з піддиректоріями будь-де в репозиторії (напр. backend/app/database/
# з кодом застосунку!) і git мовчки їх ігнорує — саме так backend/app/database/
# ніколи не потрапляв у git і на сервері падало "No module named 'app.database'".
/database/
/databases/
/backups/
/qr/
*.db
*.db-shm
*.db-wal

# ── Конфігурація (локальна) ───────────────────────────────────────────────────
.env
# .env.example НЕ ігнорується — це шаблон

# ── Логи ──────────────────────────────────────────────────────────────────────
*.log
/tmp/izi_*.log

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Claude Code ───────────────────────────────────────────────────────────────
.claude/

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
