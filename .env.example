# Скопіюй цей файл у .env і вкажи свої значення
# cp .env.example .env

# IP-адреса комп'ютера в локальній мережі.
# У dev-режимі (./start.sh) визначається й оновлюється тут автоматично —
# редагувати вручну не потрібно.
# Дізнатись вручну: ipconfig getifaddr en0   (macOS)
#                    hostname -I              (Linux)
HOST_IP=192.168.1.100
VITE_HOST_IP=192.168.1.100

# Порт, на якому реально роздається фронтенд (для CORS і посилань у QR-кодах).
# 5173 — dev-режим (vite dev). У production за nginx (deploy/deploy.sh
# виставляє це автоматично) — 80.
FRONTEND_PORT=5173
