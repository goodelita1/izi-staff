[Unit]
Description=IZI Staff — backend (FastAPI/uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=izi
Group=izi
WorkingDirectory=/opt/izi-staff/backend
ExecStartPre=/opt/izi-staff/deploy/detect_ip.sh
ExecStart=/opt/izi-staff/backend/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --log-level info
Restart=on-failure
RestartSec=3

# Логи дивитись через: journalctl -u izi-backend -f

[Install]
WantedBy=multi-user.target
